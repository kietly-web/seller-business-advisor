{
  "name": "seller-business-advisor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @sa/web dev",
    "build": "pnpm --filter @sa/web build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "16.4.5",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
